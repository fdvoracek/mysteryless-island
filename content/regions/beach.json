{
  "id": "beach",
  "name": "the beach",
  "title": "A Grey Beach",
  "order": 1,
  "description": ["wet sand, broken shells, a line of wrack.", "the wind never quite stops."],
  "climate": { "baseC": 20 },
  "travelHours": 0,
  "activities": [
    {
      "id": "light_fire",
      "name": "light fire",
      "hours": 0.5,
      "effort": "light",
      "visibleWhen": { "not": { "timer": "fire" } },
      "cost": { "firewood": 3 },
      "effects": [ { "timer": "fire", "addHours": 6 } ],
      "log": "a spark, a curl of smoke. the fire takes."
    },
    {
      "id": "stoke_fire",
      "name": "stoke fire",
      "hours": 0.25,
      "effort": "light",
      "visibleWhen": { "timer": "fire" },
      "cost": { "firewood": 2 },
      "effects": [ { "timer": "fire", "addHours": 4 } ],
      "log": ["the fire crackles.", "sparks climb into the dark."]
    },
    {
      "id": "catch_fish",
      "name": "catch fish",
      "hours": 2,
      "effort": "work",
      "requires": { "phase": ["dawn", "day", "dusk"] },
      "requiresText": "too dark to see the fish",
      "log": "you wade into the shallows, hands ready.",
      "outcomes": [
        { "weight": 4, "text": "two fish, flapping on the sand.", "effects": [ { "give": { "raw_fish": 2 } } ] },
        { "weight": 4, "text": "one fish. it will do.", "effects": [ { "give": { "raw_fish": 1 } } ] },
        { "weight": 2, "text": "nothing. the fish are quicker than you." }
      ]
    },
    {
      "id": "cook_fish",
      "name": "cook fish",
      "hours": 0.5,
      "effort": "light",
      "visibleWhen": { "seen": "raw_fish" },
      "requires": { "timer": "fire" },
      "requiresText": "the fire is out",
      "cost": { "raw_fish": 1 },
      "effects": [ { "give": { "cooked_fish": 1 } } ],
      "log": "the fish hisses on a flat stone by the fire."
    },
    {
      "id": "sleep",
      "name": "sleep",
      "hours": 8,
      "effort": "sleep",
      "requires": { "timer": "fire" },
      "requiresText": "too cold and dark to sleep without a fire",
      "checkpoint": true,
      "log": "you curl up by the fire and sleep.",
      "outcomes": [
        { "weight": 1, "when": { "phase": ["dawn", "day"] }, "text": "morning comes, grey and wet." },
        { "weight": 1, "when": { "phase": ["dusk", "night"] }, "text": "you wake in the dark. the surf is loud." }
      ]
    }
  ]
}
