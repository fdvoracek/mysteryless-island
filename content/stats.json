{
  "_note": "Survival model. All stats are 0..100. Words are picked by the first band whose upTo >= value. The panel shows each stat as an ink bar (fuller is better; hunger and thirst are drawn inverted as fullness and hydration). Health at 0 = death.",
  "dangerAtOrBelow": 20,
  "stats": [
    {
      "id": "health",
      "name": "health",
      "words": [
        { "upTo": 20, "word": "dying" },
        { "upTo": 40, "word": "badly hurt" },
        { "upTo": 60, "word": "hurt" },
        { "upTo": 80, "word": "bruised" },
        { "upTo": 100, "word": "healthy" }
      ]
    },
    {
      "id": "energy",
      "name": "energy",
      "words": [
        { "upTo": 20, "word": "exhausted" },
        { "upTo": 40, "word": "weary" },
        { "upTo": 80, "word": "tired" },
        { "upTo": 100, "word": "rested" }
      ]
    },
    {
      "id": "hunger",
      "name": "hunger",
      "label": "fullness",
      "highIsBad": true,
      "words": [
        { "upTo": 20, "word": "fed" },
        { "upTo": 40, "word": "peckish" },
        { "upTo": 80, "word": "hungry" },
        { "upTo": 100, "word": "starving" }
      ]
    },
    {
      "id": "thirst",
      "name": "thirst",
      "label": "hydration",
      "highIsBad": true,
      "words": [
        { "upTo": 20, "word": "quenched" },
        { "upTo": 40, "word": "dry" },
        { "upTo": 80, "word": "thirsty" },
        { "upTo": 100, "word": "parched" }
      ]
    }
  ],
  "ratesPerHour": {
    "heavy": { "hunger": 4, "thirst": 6, "energy": -8 },
    "work": { "hunger": 3, "thirst": 5, "energy": -5 },
    "light": { "hunger": 2, "thirst": 4, "energy": -2 },
    "rest": { "hunger": 2, "thirst": 3, "energy": 4 },
    "sleep": { "hunger": 1.5, "thirst": 2, "energy": 11 }
  },
  "multipliers": [
    { "when": { "warmth": ["cold", "freezing"] }, "stat": "hunger", "factor": 1.25 },
    {
      "when": { "all": [{ "effort": ["sleep"] }, { "built": "bed" }, { "at": "beach" }] },
      "stat": "energy",
      "factor": 1.4
    }
  ],
  "damage": [
    {
      "when": { "stat": "hunger", "gte": 80 },
      "healthPerHour": -2,
      "log": [
        "Hunger gnaws at you. Your hands shake.",
        "Your stomach cramps with hunger.",
        "Hunger makes you dizzy."
      ],
      "cause": "hunger"
    },
    {
      "when": { "stat": "thirst", "gte": 80 },
      "healthPerHour": -2,
      "log": [
        "Your lips crack. The world tilts.",
        "Your throat burns with thirst.",
        "Thirst blurs your sight."
      ],
      "cause": "thirst"
    },
    {
      "when": { "all": [{ "stat": "energy", "lte": 0 }, { "effort": ["heavy", "work"] }] },
      "healthPerHour": -2,
      "log": ["You work on, past exhaustion.", "Your body begs for rest.", "Every movement is an effort now."],
      "cause": "exhaustion"
    },
    {
      "when": { "warmth": ["freezing"] },
      "healthPerHour": -3,
      "log": ["The cold is in your bones.", "You can't stop shivering.", "The cold numbs your fingers."],
      "cause": "cold"
    }
  ],
  "regen": [
    {
      "when": {
        "all": [
          { "stat": "hunger", "lte": 50 },
          { "stat": "thirst", "lte": 50 },
          { "warmth": ["comfortable"] }
        ]
      },
      "healthPerHour": 1
    },
    {
      "when": {
        "all": [{ "effort": ["sleep"] }, { "stat": "hunger", "lte": 50 }, { "stat": "thirst", "lte": 50 }]
      },
      "healthPerHour": 2
    },
    {
      "when": {
        "all": [
          { "effort": ["sleep"] },
          { "built": "bed" },
          { "at": "beach" },
          { "stat": "hunger", "lte": 50 },
          { "stat": "thirst", "lte": 50 }
        ]
      },
      "healthPerHour": 1
    }
  ]
}
