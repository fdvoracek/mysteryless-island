{
  "name": "mysteryless-island",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimalist, data-driven text survival game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "content:check": "vitest run tests/content.test.ts",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
