exports[`PR-01 golden traces on frozen content > records the shipwreck knife branch and reloads its open scene 1`] = `
{
  "journal": [
    {
      "at": 360,
      "text": "You were three days out when the storm came. All evening the wind rose, and by midnight the boat was climbing black waves and falling into the troughs between them.",
      "turn": 1,
    },
    {
      "at": 360,
      "text": "Then, in the dark, a crack like a gunshot. The hull has struck rock. Water roars in below deck and the ship lurches, already lower in the sea.",
      "turn": 2,
    },
    {
      "at": 360,
      "text": "There is a moment, no more, to grab one thing before you jump.",
      "turn": 3,
    },
    {
      "at": 360,
      "text": "You jump with the knife clenched in your fist. The cold punches the breath out of you. A wave throws you under, then another, and each time you claw back to the surface, still gripping the blade.",
      "turn": 6,
    },
    {
      "at": 360,
      "text": "You swim until your arms stop answering. Then sand scrapes your knees. You crawl out of the surf and lie still, the knife in your hand.",
      "turn": 7,
    },
    {
      "at": 360,
      "text": "You come to at the tide line, clothes heavy with water. Nothing on the horizon, nothing left of the ship. Behind the dunes, trees.",
      "turn": 9,
    },
  ],
  "seed": 7,
  "state": {
    "actions": [],
    "buildings": {},
    "counters": {},
